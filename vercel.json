{
  "version": 2,
  "name": "vshakyagallery",
  "alias": [
    "vshakyagallery.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|uploads|assets|artworks|textures|hdri|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
